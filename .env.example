APP_NAME=QuizOCR Grader

# --- Default AI gateway (used when provider-specific values are omitted) ---
AI_BASE_URL=https://example-ai-gateway.com/v1
AI_API_KEY=your_api_key

# --- Vision provider (rubric parsing, student answer extraction) ---
# Falls back to AI_BASE_URL / AI_API_KEY if left empty.
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=sk-your-openai-key
AI_VISION_MODEL=gpt-4o
# Optional fallback chains override AI_VISION_MODEL for specific tasks.
# JSON array order is preferred model first, fallback models later.
# Candidate base_url/api_key may be omitted to use AI_VISION_BASE_URL/AI_VISION_API_KEY or AI_BASE_URL/AI_API_KEY.
# Example: use a stronger OCR model first, then fall back to the default vision model.
# AI_VISION_STUDENT_EXTRACTION_CHAIN=[{"model":"gemini-2.5-pro","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"your-gemini-key"},{"model":"gpt-4o"}]
# AI_VISION_RUBRIC_CHAIN=[{"model":"gpt-4o"}]
# AI_VISION_SPLIT_HEADER_CHAIN=[{"model":"gemini-2.5-flash","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"your-gemini-key"},{"model":"gpt-4o"}]
# Image-grounded review candidates must support image input. Set supports_vision=false to skip text-only models in image routes.
# AI_VISION_GRADING_REVIEW_CHAIN=[{"model":"gpt-4o","supports_vision":true}]
# Optional roster (考试名单) extraction chain. PDF rosters are routed through vision; CSV/Excel skip the model entirely.
# AI_VISION_ROSTER_CHAIN=[{"model":"gpt-4o"}]
# AI_VISION_CHAIN=[{"model":"gpt-4o"}]

# --- Grading provider (question scoring) ---
# Falls back to AI_BASE_URL / AI_API_KEY if left empty.
# Example for DeepSeek:
# AI_GRADING_BASE_URL=https://api.deepseek.com/v1
# AI_GRADING_API_KEY=sk-your-deepseek-key
AI_GRADING_MODEL=gpt-4.1
# Optional grading fallback chain. Candidate base_url/api_key may be omitted to use grading/default provider settings.
# AI_GRADING_CHAIN=[{"model":"gpt-4.1"},{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-your-deepseek-key"}]
# Optional quality review pass: fast grading uses AI_GRADING_MODEL/AI_GRADING_CHAIN; review uses these settings only when triggered.
AI_GRADING_REVIEW_ENABLED=false
# Text-only strong review models such as DeepSeek belong here; image evidence review uses AI_VISION_GRADING_REVIEW_CHAIN.
# AI_GRADING_REVIEW_MODEL=deepseek-chat
# AI_GRADING_REVIEW_CHAIN=[{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-your-deepseek-key"}]
AI_GRADING_REVIEW_SCORE_DELTA_RATIO=0.15
AI_GRADING_REVIEW_VARIANCE_MIN_ANSWERS=3
AI_GRADING_REVIEW_VARIANCE_RANGE_RATIO=0.45
# Per-submission grading calls. Keep below provider rate limits; DeepSeek may rate-limit at 8.
AI_GRADING_CONCURRENCY=4
# Process-wide grading call cap for each worker process.
AI_GRADING_GLOBAL_CONCURRENCY=4

# Grading strictness: "strict" | "moderate" | "lenient"
# strict: evidence-only exact scoring; moderate: fair evidence-based partial credit; lenient: generous partial credit for relevant attempts only.
AI_GRADING_STRICTNESS=moderate

AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1

# --- Optional OCR pre-processing (disabled by default; PaddleOCR token must stay in .env only) ---
OCR_PREPROCESS_ENABLED=false
OCR_PREPROCESS_RUBRIC_ENABLED=false
OCR_PREPROCESS_STUDENT_ENABLED=true
OCR_PREPROCESS_SPLIT_HEADER_ENABLED=true
PADDLE_OCR_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# PADDLE_OCR_API_KEY=your_paddleocr_token
PADDLE_OCR_MODEL=PaddleOCR-VL-1.5
PADDLE_OCR_TIMEOUT_SECONDS=120
PADDLE_OCR_POLL_INTERVAL_SECONDS=5
PADDLE_OCR_MAX_POLL_SECONDS=120
OCR_MIN_TEXT_CHARS_FOR_REFERENCE=80
OCR_SPLIT_HEADER_MIN_CONFIDENCE=0.75
OCR_SPLIT_HEADER_CONCURRENCY=4

DATABASE_URL=postgresql+psycopg://grader:grader@localhost:5432/grader
REDIS_URL=redis://localhost:6379/0
DOCKER_DATABASE_URL=postgresql+psycopg://grader:grader@postgres:5432/grader
DOCKER_REDIS_URL=redis://redis:6379/0
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
RENDER_DPI=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
POSTGRES_USER=grader
POSTGRES_PASSWORD=grader
POSTGRES_DB=grader
VITE_API_BASE_URL=http://localhost:8000/api
