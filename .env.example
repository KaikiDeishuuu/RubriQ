# QuizOCR Grader environment example
# QuizOCR Grader 环境变量示例
#
# 使用方法：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 只在 .env 中填写真实 API Key；不要把 .env 提交到 git。
# 3. 最小可运行配置：填写 AI_BASE_URL / AI_API_KEY，并确认 AI_VISION_MODEL、AI_GRADING_MODEL 可用。
# 4. 如果视觉模型和评分模型来自不同服务商，填写 AI_VISION_* 和 AI_GRADING_* 覆盖默认网关。
#
# JSON 链配置说明：
# - *_CHAIN 必须是单行 JSON 数组，按顺序从首选模型 fallback 到备用模型。
# - candidate 可省略 base_url/api_key，省略时使用对应 profile 的默认 base_url/api_key。
# - 图片路线必须使用支持图片输入的模型；不支持图片的 candidate 设置 supports_vision=false。

APP_NAME=QuizOCR Grader

# =============================================================================
# 1) 默认 AI 网关 / Default AI gateway
# =============================================================================
# 用途：当 AI_VISION_* 或 AI_GRADING_* 未填写时，会回退到这里。
# 填写 OpenAI-compatible /v1 地址，例如 https://api.openai.com/v1 或你的中转网关。
AI_BASE_URL=https://example-ai-gateway.com/v1
AI_API_KEY=your_api_key

# =============================================================================
# 2) 视觉模型 / Vision provider
# =============================================================================
# 用途：rubric 解析、学生答案抽取、批量拆分页眉识别、图片证据复审。
# 留空 AI_VISION_BASE_URL / AI_VISION_API_KEY 时，使用 AI_BASE_URL / AI_API_KEY。
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=sk-your-openai-key
AI_VISION_MODEL=gpt-4o

# 视觉 fallback 链：可为不同任务单独配置。
# Example: first use Gemini for answer extraction, then fall back to GPT-4o.
# AI_VISION_STUDENT_EXTRACTION_CHAIN=[{"model":"gemini-2.5-pro","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"your-gemini-key"},{"model":"gpt-4o"}]
# AI_VISION_RUBRIC_CHAIN=[{"model":"gpt-4o"}]
# AI_VISION_SPLIT_HEADER_CHAIN=[{"model":"gemini-2.5-flash","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"your-gemini-key"},{"model":"gpt-4o"}]
# 图片证据复审必须使用支持图片的模型。Text-only 模型请放到 AI_GRADING_REVIEW_*。
# AI_VISION_GRADING_REVIEW_CHAIN=[{"model":"gpt-4o","supports_vision":true}]
# 考试名单 PDF 抽取使用 vision；CSV/Excel 名单不会调用模型。
# AI_VISION_ROSTER_CHAIN=[{"model":"gpt-4o"}]
# AI_VISION_CHAIN=[{"model":"gpt-4o"}]

# =============================================================================
# 3) 评分模型 / Grading provider
# =============================================================================
# 用途：按 rubric 对每道题文字答案打分。
# 留空 AI_GRADING_BASE_URL / AI_GRADING_API_KEY 时，使用 AI_BASE_URL / AI_API_KEY。
# DeepSeek 示例：
# AI_GRADING_BASE_URL=https://api.deepseek.com/v1
# AI_GRADING_API_KEY=sk-your-deepseek-key
AI_GRADING_MODEL=gpt-4.1

# 快速评分 fallback 链：前面的模型失败后才会尝试后面的模型。
# AI_GRADING_CHAIN=[{"model":"gpt-4.1"},{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-your-deepseek-key"}]

# =============================================================================
# 4) 可选质量复审 / Optional grading review
# =============================================================================
# 用途：对低置信度、低分但非空、公式题、批内分差过大等答案做二次复审。
# false = 只做快速评分；true = 触发条件满足时增加复审成本但更稳。
AI_GRADING_REVIEW_ENABLED=false
# Text-only 强模型放这里；图片证据复审放 AI_VISION_GRADING_REVIEW_CHAIN。
# AI_GRADING_REVIEW_MODEL=deepseek-chat
# AI_GRADING_REVIEW_CHAIN=[{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-your-deepseek-key"}]
AI_GRADING_REVIEW_SCORE_DELTA_RATIO=0.15
AI_GRADING_REVIEW_LOW_SCORE_RATIO=0.25
AI_GRADING_REVIEW_FORMULA_FORCE_REVIEW=true
AI_GRADING_REVIEW_ZERO_SCORE_FORCE_REVIEW=true
AI_GRADING_REVIEW_VARIANCE_MIN_ANSWERS=3
AI_GRADING_REVIEW_VARIANCE_RANGE_RATIO=0.45

# =============================================================================
# 5) 并发、超时、重试 / Concurrency, timeout, retry
# =============================================================================
# 单个 submission 内并发评分题目数。服务商容易限流时调低。
AI_GRADING_CONCURRENCY=4
# 单个 worker 进程内全局评分调用上限。
AI_GRADING_GLOBAL_CONCURRENCY=4
# 批量评分每一轮最多派发多少份 submission；越小越稳，越大越快。
AI_GRADING_BATCH_SIZE=5
# 评分严格度：strict | moderate | lenient
# strict=严格按证据；moderate=默认公平给分；lenient=对相关尝试更宽松，但不会给无关答案加分。
AI_GRADING_STRICTNESS=moderate

AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1

# 卡住状态扫尾：worker 被 hard kill / 后台关闭后，超过该时间仍处于 active 状态会被标记失败，之后可手动重试。
# 默认值应大于 Celery soft time limit；一般无需修改。
GRADING_STALE_SUBMISSION_SECONDS=1200
GRADING_STALE_BATCH_REVIEW_SECONDS=3000

# =============================================================================
# 6) 可选 OCR 预处理 / Optional PaddleOCR preprocessing
# =============================================================================
# 默认关闭。开启后 OCR 文本只作为 vision prompt 的参考，不直接替代图片判断。
# PADDLE_OCR_API_KEY 只填在 .env 或部署密钥里，不要提交。
OCR_PREPROCESS_ENABLED=false
OCR_PREPROCESS_RUBRIC_ENABLED=false
OCR_PREPROCESS_STUDENT_ENABLED=true
OCR_PREPROCESS_SPLIT_HEADER_ENABLED=true
OCR_PREPROCESS_ROSTER_ENABLED=false
PADDLE_OCR_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# PADDLE_OCR_API_KEY=your_paddleocr_token
PADDLE_OCR_MODEL=PaddleOCR-VL-1.5
PADDLE_OCR_TIMEOUT_SECONDS=120
PADDLE_OCR_POLL_INTERVAL_SECONDS=5
PADDLE_OCR_MAX_POLL_SECONDS=120
OCR_MIN_TEXT_CHARS_FOR_REFERENCE=80
OCR_SPLIT_HEADER_MIN_CONFIDENCE=0.75
OCR_SPLIT_HEADER_CONCURRENCY=4

# =============================================================================
# 7) 数据库、Redis、存储 / Database, Redis, storage
# =============================================================================
# 本机直接运行 backend 时使用 DATABASE_URL / REDIS_URL。
DATABASE_URL=postgresql+psycopg://grader:grader@localhost:5432/grader
REDIS_URL=redis://localhost:6379/0
# Docker Compose 内部服务连接使用 DOCKER_*；通常保持默认即可。
DOCKER_DATABASE_URL=postgresql+psycopg://grader:grader@postgres:5432/grader
DOCKER_REDIS_URL=redis://redis:6379/0
POSTGRES_USER=grader
POSTGRES_PASSWORD=grader
POSTGRES_DB=grader
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
RENDER_DPI=200

# =============================================================================
# 8) 认证和前端 / Auth and frontend
# =============================================================================
# 生产或共享环境建议设置 ADMIN_API_TOKEN，并将 ADMIN_API_TOKEN_REQUIRED=true。
# 前端登录页会保存 token 并自动附带 Authorization: Bearer <token>。
ADMIN_API_TOKEN=
ADMIN_API_TOKEN_REQUIRED=false
# 如果前端端口不是 5173，或使用 127.0.0.1:5174 等 Vite 临时端口，需要把 origin 加进 CORS_ORIGINS。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 后端 API 前缀；通常保持 /api，并与 VITE_API_BASE_URL 结尾一致。
API_V1_PREFIX=/api
VITE_API_BASE_URL=http://localhost:8000/api
LOG_LEVEL=INFO

# =============================================================================
# 9) 导出、上传、批量 ZIP 限制 / Export, upload, batch ZIP limits
# =============================================================================
EXPORT_GLOBAL_CONCURRENCY=2
EXPORT_SUBMISSIONS_ZIP_MAX_SUBMISSIONS=200
SUBMISSIONS_UPLOAD_MAX_FILES=20
BATCH_ZIP_MAX_ENTRIES=300
BATCH_ZIP_MAX_UNCOMPRESSED_BYTES=2147483648
